# Parasight-AMA runtime configuration (read by systemd via EnvironmentFile=).
# Install as /etc/parasight/parasight.env  (root:root, 0644 — no secrets here).
# Plain KEY=VALUE lines only: systemd does not expand variables or `~` here.

# --- Network ---------------------------------------------------------------
# 0.0.0.0 = reachable from the LAN (restrict with ufw, see DEPLOY.md).
# 127.0.0.1 = local only (use an SSH tunnel or a reverse proxy in front).
APP_HOST=0.0.0.0
APP_PORT=8010

# --- Data (put /srv/parasight on a large volume, not the root filesystem) ---
# Only per-job data lives under data/; each folder gets a README.txt at startup.
DATA_DIR=/srv/parasight/data
# Original uploads and results: keep (removed only by parasight-cleanup.sh).
UPLOADS_DIR=/srv/parasight/data/uploads
OUTPUTS_DIR=/srv/parasight/data/outputs
# Working files of running jobs (unzipped inputs); the app deletes
# processing/<job> when the job ends. (Formerly TEMP_DIR=.../data/temp.)
PROCESSING_DIR=/srv/parasight/data/processing

# Max size of one uploaded file (MB); larger uploads get HTTP 413. 0 = no limit.
# The app default is 500, which is small for batches of .tiff/.czi images.
# The body is still spooled to $TMPDIR before the check, so also cap it at a
# reverse proxy if disk space is a concern.
MAX_UPLOAD_MB=20480

# Scratch space of the service process (not job data): uploads in transit
# before they are copied to UPLOADS_DIR, plus TensorFlow/PyTorch temp files.
# /tmp is often on a small root disk, so a large ZIP upload could fill /.
# Safe to empty whenever no upload is in progress. (Formerly .../data/tmp.)
TMPDIR=/srv/parasight/tmp

# --- Model weights / caches (downloaded on first run) ------------------------
# Cellpose weights (~/.cellpose by default)
CELLPOSE_LOCAL_MODELS_PATH=/srv/parasight/cache/cellpose
# StarDist/Keras weights land in $HOME/.keras; HOME is the service user's home
# (/srv/parasight), set by the user account and repeated here for clarity.
HOME=/srv/parasight
MPLCONFIGDIR=/srv/parasight/cache/matplotlib

# Never pick up packages from the service user's ~/.local.
PYTHONNOUSERSITE=1

# --- GPU / TensorFlow ------------------------------------------------------
# Cellpose (PyTorch) uses the GPU; TensorFlow is the CPU build (StarDist).
CUDA_VISIBLE_DEVICES=0
TF_CPP_MIN_LOG_LEVEL=2
